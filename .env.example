# Copy this file to .env.local and fill in real values.
# Development deployment (used by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-dev-deployment-name

VITE_CONVEX_URL=https://your-dev-deployment-name.convex.cloud
CONVEX_SITE_URL=https://your-dev-deployment-name.convex.site

# Third-party secrets
MAILGUN_SECRET=your-mailgun-secret

# reCAPTCHA
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_PROJECT_ID=your-recaptcha-project-id
RECAPTCHA_API_KEY=your-recaptcha-api-key
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET=your-recaptcha-secret
RECAPTCHA_MIN_SCORE=0.5