{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "convex/**/*.ts",
      "vite.config.ts",
      "vitest.config.ts",
      "*.json",
      "*.md",
      "docs/**/*.md",
      "!src/routeTree.gen.ts",
      "!convex/_generated",
      "!.output",
      "!dist",
      "!dist-ssr"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useButtonType": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      }
    }
  }
}
